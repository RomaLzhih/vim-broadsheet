" =============================================================================
" airline/themes/swan_budapest.vim — the folio line for the swan-budapest colorscheme
" =============================================================================
"
" Generated by scripts/gen_airline.py from the palette in
" colors/swan-budapest.vim; every pair below is asserted at WCAG AA.
"
" airline#switch_matching_theme() resolves an airline theme by the
" colorscheme name, so this file is picked up automatically.  Without it
" airline derives its own colours and can land far outside the palette --
" it put bg_deep text on bg_alt here, about 1.1:1, which is what made the
" statusline and tab labels unreadable.
"
" The mode block follows the family's inverted-cell logic: a bright accent
" with the paper stock laid over it, the same shape as IncSearch.
" =============================================================================

let g:airline#themes#swan_budapest#palette = {}

" Two editions.  airline calls refresh() on every theme load, and Vim
" re-sources the colorscheme when 'background' changes, so the bar turns
" with the page.
function! airline#themes#swan_budapest#refresh() abort
  if &background ==# 'light'
    " normal: the mode block wears ink
    let s:normal_a = ['#f6e9ef', '#231a2c', 255, 234]
    let s:normal_b = ['#231a2c', '#e4d0d9', 234, 253]
    let s:normal_c = ['#231a2c', '#eedee6', 234, 254]
    let g:airline#themes#swan_budapest#palette.normal = airline#themes#generate_color_map(s:normal_a, s:normal_b, s:normal_c)
    let g:airline#themes#swan_budapest#palette.normal_modified = { 'airline_c': ['#8e3268', '#eedee6', 89, 254] }

    " insert: the mode block wears quote
    let s:insert_a = ['#f6e9ef', '#805619', 255, 94]
    let s:insert_b = ['#231a2c', '#e4d0d9', 234, 253]
    let s:insert_c = ['#231a2c', '#eedee6', 234, 254]
    let g:airline#themes#swan_budapest#palette.insert = airline#themes#generate_color_map(s:insert_a, s:insert_b, s:insert_c)
    let g:airline#themes#swan_budapest#palette.insert_modified = { 'airline_c': ['#8e3268', '#eedee6', 89, 254] }

    " replace: the mode block wears alert
    let s:replace_a = ['#f6e9ef', '#b82636', 255, 167]
    let s:replace_b = ['#231a2c', '#e4d0d9', 234, 253]
    let s:replace_c = ['#231a2c', '#eedee6', 234, 254]
    let g:airline#themes#swan_budapest#palette.replace = airline#themes#generate_color_map(s:replace_a, s:replace_b, s:replace_c)
    let g:airline#themes#swan_budapest#palette.replace_modified = { 'airline_c': ['#8e3268', '#eedee6', 89, 254] }

    " visual: the mode block wears opt
    let s:visual_a = ['#f6e9ef', '#57618c', 255, 60]
    let s:visual_b = ['#231a2c', '#e4d0d9', 234, 253]
    let s:visual_c = ['#231a2c', '#eedee6', 234, 254]
    let g:airline#themes#swan_budapest#palette.visual = airline#themes#generate_color_map(s:visual_a, s:visual_b, s:visual_c)
    let g:airline#themes#swan_budapest#palette.visual_modified = { 'airline_c': ['#8e3268', '#eedee6', 89, 254] }

    " An inactive split recedes by going quiet, never by becoming unreadable.
    let g:airline#themes#swan_budapest#palette.inactive = airline#themes#generate_color_map(['#715e68', '#eedee6', 241, 254], ['#715e68', '#eedee6', 241, 254], ['#715e68', '#eedee6', 241, 254])
    let g:airline#themes#swan_budapest#palette.inactive_modified = { 'airline_c': ['#715e68', '#eedee6', 241, 254] }

    " The tab strip: the current tab is a paper step, the others recede one
    " ink weight.  Same reasoning as the completion menu -- a filled accent
    " block for the selected row is the heaviest thing on the page.
    let g:airline#themes#swan_budapest#palette.tabline = {
          \ 'airline_tab':     ['#4a3b4c', '#eedee6', 238, 254],
          \ 'airline_tabsel':  ['#231a2c', '#ddc6d1', 234, 252],
          \ 'airline_tabtype': ['#f6e9ef', '#805619', 255, 94],
          \ 'airline_tabfill': ['#4a3b4c', '#eedee6', 238, 254],
          \ 'airline_tabmod':  ['#f6e9ef', '#8e3268', 255, 89],
          \ 'airline_tabhid':  ['#715e68', '#eedee6', 241, 254],
          \ }

    " Warning and error accents, used by the whitespace and diagnostics parts.
    let g:airline#themes#swan_budapest#palette.accents = { 'red': ['#b82636', '#eedee6', 167, 254] }
  else
    " normal: the mode block wears ink
    let s:normal_a = ['#1a131f', '#f6eae9', 234, 255]
    let s:normal_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:normal_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest#palette.normal = airline#themes#generate_color_map(s:normal_a, s:normal_b, s:normal_c)
    let g:airline#themes#swan_budapest#palette.normal_modified = { 'airline_c': ['#e6a0c4', '#241c2b', 218, 235] }

    " insert: the mode block wears quote
    let s:insert_a = ['#1a131f', '#f1bb7b', 234, 179]
    let s:insert_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:insert_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest#palette.insert = airline#themes#generate_color_map(s:insert_a, s:insert_b, s:insert_c)
    let g:airline#themes#swan_budapest#palette.insert_modified = { 'airline_c': ['#e6a0c4', '#241c2b', 218, 235] }

    " replace: the mode block wears alert
    let s:replace_a = ['#1a131f', '#fd6467', 234, 203]
    let s:replace_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:replace_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest#palette.replace = airline#themes#generate_color_map(s:replace_a, s:replace_b, s:replace_c)
    let g:airline#themes#swan_budapest#palette.replace_modified = { 'airline_c': ['#e6a0c4', '#241c2b', 218, 235] }

    " visual: the mode block wears opt
    let s:visual_a = ['#1a131f', '#c6cdf7', 234, 189]
    let s:visual_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:visual_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest#palette.visual = airline#themes#generate_color_map(s:visual_a, s:visual_b, s:visual_c)
    let g:airline#themes#swan_budapest#palette.visual_modified = { 'airline_c': ['#e6a0c4', '#241c2b', 218, 235] }

    " An inactive split recedes by going quiet, never by becoming unreadable.
    let g:airline#themes#swan_budapest#palette.inactive = airline#themes#generate_color_map(['#9e92a2', '#241c2b', 246, 235], ['#9e92a2', '#241c2b', 246, 235], ['#9e92a2', '#241c2b', 246, 235])
    let g:airline#themes#swan_budapest#palette.inactive_modified = { 'airline_c': ['#9e92a2', '#241c2b', 246, 235] }

    " The tab strip: the current tab is a paper step, the others recede one
    " ink weight.  Same reasoning as the completion menu -- a filled accent
    " block for the selected row is the heaviest thing on the page.
    let g:airline#themes#swan_budapest#palette.tabline = {
          \ 'airline_tab':     ['#cfc3cd', '#241c2b', 251, 235],
          \ 'airline_tabsel':  ['#f6eae9', '#34293d', 255, 237],
          \ 'airline_tabtype': ['#1a131f', '#f1bb7b', 234, 179],
          \ 'airline_tabfill': ['#cfc3cd', '#241c2b', 251, 235],
          \ 'airline_tabmod':  ['#1a131f', '#e6a0c4', 234, 218],
          \ 'airline_tabhid':  ['#9e92a2', '#241c2b', 246, 235],
          \ }

    " Warning and error accents, used by the whitespace and diagnostics parts.
    let g:airline#themes#swan_budapest#palette.accents = { 'red': ['#fd6467', '#241c2b', 203, 235] }
  endif
endfunction

call airline#themes#swan_budapest#refresh()

