" =============================================================================
" airline/themes/swan_vga.vim — the folio line for the swan-vga colorscheme
" =============================================================================
"
" Generated by scripts/gen_airline.py from the palette in
" colors/swan-vga.vim; every pair below is asserted at WCAG AA.
"
" airline#switch_matching_theme() resolves an airline theme by the
" colorscheme name, so this file is picked up automatically.  Without it
" airline derives its own colours and can land far outside the palette --
" it put bg_deep text on bg_alt here, about 1.1:1, which is what made the
" statusline and tab labels unreadable.
"
" The mode block follows the family's inverted-cell logic: a bright accent
" with the paper stock laid over it, the same shape as IncSearch.
" =============================================================================

let g:airline#themes#swan_vga#palette = {}

" normal: the mode block wears ink
let s:normal_a = ['#000000', '#ffffff', 16, 231]
let s:normal_b = ['#ffffff', '#16163a', 231, 234]
let s:normal_c = ['#ffffff', '#101016', 231, 233]
let g:airline#themes#swan_vga#palette.normal = airline#themes#generate_color_map(s:normal_a, s:normal_b, s:normal_c)
let g:airline#themes#swan_vga#palette.normal_modified = { 'airline_c': ['#ff55ff', '#101016', 207, 233] }

" insert: the mode block wears quote
let s:insert_a = ['#000000', '#55ff55', 16, 83]
let s:insert_b = ['#ffffff', '#16163a', 231, 234]
let s:insert_c = ['#ffffff', '#101016', 231, 233]
let g:airline#themes#swan_vga#palette.insert = airline#themes#generate_color_map(s:insert_a, s:insert_b, s:insert_c)
let g:airline#themes#swan_vga#palette.insert_modified = { 'airline_c': ['#ff55ff', '#101016', 207, 233] }

" replace: the mode block wears alert
let s:replace_a = ['#000000', '#ff5555', 16, 203]
let s:replace_b = ['#ffffff', '#16163a', 231, 234]
let s:replace_c = ['#ffffff', '#101016', 231, 233]
let g:airline#themes#swan_vga#palette.replace = airline#themes#generate_color_map(s:replace_a, s:replace_b, s:replace_c)
let g:airline#themes#swan_vga#palette.replace_modified = { 'airline_c': ['#ff55ff', '#101016', 207, 233] }

" visual: the mode block wears opt
let s:visual_a = ['#000000', '#ffff55', 16, 227]
let s:visual_b = ['#ffffff', '#16163a', 231, 234]
let s:visual_c = ['#ffffff', '#101016', 231, 233]
let g:airline#themes#swan_vga#palette.visual = airline#themes#generate_color_map(s:visual_a, s:visual_b, s:visual_c)
let g:airline#themes#swan_vga#palette.visual_modified = { 'airline_c': ['#ff55ff', '#101016', 207, 233] }

" An inactive split recedes by going quiet, never by becoming unreadable.
let g:airline#themes#swan_vga#palette.inactive = airline#themes#generate_color_map(['#8a8a8a', '#101016', 245, 233], ['#8a8a8a', '#101016', 245, 233], ['#8a8a8a', '#101016', 245, 233])
let g:airline#themes#swan_vga#palette.inactive_modified = { 'airline_c': ['#8a8a8a', '#101016', 245, 233] }

" The tab strip: the current tab is a paper step, the others recede one
" ink weight.  Same reasoning as the completion menu -- a filled accent
" block for the selected row is the heaviest thing on the page.
let g:airline#themes#swan_vga#palette.tabline = {
      \ 'airline_tab':     ['#aaaaaa', '#101016', 248, 233],
      \ 'airline_tabsel':  ['#ffffff', '#222250', 231, 17],
      \ 'airline_tabtype': ['#000000', '#55ff55', 16, 83],
      \ 'airline_tabfill': ['#aaaaaa', '#101016', 248, 233],
      \ 'airline_tabmod':  ['#000000', '#ff55ff', 16, 207],
      \ 'airline_tabhid':  ['#8a8a8a', '#101016', 245, 233],
      \ }

" Warning and error accents, used by the whitespace and diagnostics parts.
let g:airline#themes#swan_vga#palette.accents = { 'red': ['#ff5555', '#101016', 203, 233] }

