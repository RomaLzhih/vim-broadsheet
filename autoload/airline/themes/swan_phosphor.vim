" =============================================================================
" airline/themes/swan_phosphor.vim — the folio line for the swan-phosphor colorscheme
" =============================================================================
"
" Generated by scripts/gen_airline.py from the palette in
" colors/swan-phosphor.vim; every pair below is asserted at WCAG AA.
"
" airline#switch_matching_theme() resolves an airline theme by the
" colorscheme name, so this file is picked up automatically.  Without it
" airline derives its own colours and can land far outside the palette --
" it put bg_deep text on bg_alt here, about 1.1:1, which is what made the
" statusline and tab labels unreadable.
"
" The mode block follows the family's inverted-cell logic: a bright accent
" with the paper stock laid over it, the same shape as IncSearch.
" =============================================================================

let g:airline#themes#swan_phosphor#palette = {}

" normal: the mode block wears ink
let s:normal_a = ['#050d07', '#d6ecd0', 232, 194]
let s:normal_b = ['#d6ecd0', '#16261a', 194, 235]
let s:normal_c = ['#d6ecd0', '#0d1a10', 194, 233]
let g:airline#themes#swan_phosphor#palette.normal = airline#themes#generate_color_map(s:normal_a, s:normal_b, s:normal_c)
let g:airline#themes#swan_phosphor#palette.normal_modified = { 'airline_c': ['#ffb000', '#0d1a10', 214, 233] }

" insert: the mode block wears quote
let s:insert_a = ['#050d07', '#56d8d8', 232, 80]
let s:insert_b = ['#d6ecd0', '#16261a', 194, 235]
let s:insert_c = ['#d6ecd0', '#0d1a10', 194, 233]
let g:airline#themes#swan_phosphor#palette.insert = airline#themes#generate_color_map(s:insert_a, s:insert_b, s:insert_c)
let g:airline#themes#swan_phosphor#palette.insert_modified = { 'airline_c': ['#ffb000', '#0d1a10', 214, 233] }

" replace: the mode block wears alert
let s:replace_a = ['#050d07', '#ff6b5e', 232, 203]
let s:replace_b = ['#d6ecd0', '#16261a', 194, 235]
let s:replace_c = ['#d6ecd0', '#0d1a10', 194, 233]
let g:airline#themes#swan_phosphor#palette.replace = airline#themes#generate_color_map(s:replace_a, s:replace_b, s:replace_c)
let g:airline#themes#swan_phosphor#palette.replace_modified = { 'airline_c': ['#ffb000', '#0d1a10', 214, 233] }

" visual: the mode block wears opt
let s:visual_a = ['#050d07', '#5ce6b0', 232, 79]
let s:visual_b = ['#d6ecd0', '#16261a', 194, 235]
let s:visual_c = ['#d6ecd0', '#0d1a10', 194, 233]
let g:airline#themes#swan_phosphor#palette.visual = airline#themes#generate_color_map(s:visual_a, s:visual_b, s:visual_c)
let g:airline#themes#swan_phosphor#palette.visual_modified = { 'airline_c': ['#ffb000', '#0d1a10', 214, 233] }

" An inactive split recedes by going quiet, never by becoming unreadable.
let g:airline#themes#swan_phosphor#palette.inactive = airline#themes#generate_color_map(['#7fa084', '#0d1a10', 108, 233], ['#7fa084', '#0d1a10', 108, 233], ['#7fa084', '#0d1a10', 108, 233])
let g:airline#themes#swan_phosphor#palette.inactive_modified = { 'airline_c': ['#7fa084', '#0d1a10', 108, 233] }

" The tab strip: the current tab is a paper step, the others recede one
" ink weight.  Same reasoning as the completion menu -- a filled accent
" block for the selected row is the heaviest thing on the page.
let g:airline#themes#swan_phosphor#palette.tabline = {
      \ 'airline_tab':     ['#a2bfa0', '#0d1a10', 151, 233],
      \ 'airline_tabsel':  ['#d6ecd0', '#203524', 194, 236],
      \ 'airline_tabtype': ['#050d07', '#56d8d8', 232, 80],
      \ 'airline_tabfill': ['#a2bfa0', '#0d1a10', 151, 233],
      \ 'airline_tabmod':  ['#050d07', '#ffb000', 232, 214],
      \ 'airline_tabhid':  ['#7fa084', '#0d1a10', 108, 233],
      \ }

" Warning and error accents, used by the whitespace and diagnostics parts.
let g:airline#themes#swan_phosphor#palette.accents = { 'red': ['#ff6b5e', '#0d1a10', 203, 233] }

