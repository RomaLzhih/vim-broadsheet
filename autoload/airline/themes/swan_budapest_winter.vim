" =============================================================================
" airline/themes/swan_budapest_winter.vim — the folio line for the swan-budapest-winter colorscheme
" =============================================================================
"
" Generated by scripts/gen_airline.py from the palette in
" colors/swan-budapest-winter.vim; every pair below is asserted at WCAG AA.
"
" airline#switch_matching_theme() resolves an airline theme by the
" colorscheme name, so this file is picked up automatically.  Without it
" airline derives its own colours and can land far outside the palette --
" it put bg_deep text on bg_alt here, about 1.1:1, which is what made the
" statusline and tab labels unreadable.
"
" The mode block follows the family's inverted-cell logic: a bright accent
" with the paper stock laid over it, the same shape as IncSearch.
" =============================================================================

let g:airline#themes#swan_budapest_winter#palette = {}

" Two editions.  airline calls refresh() on every theme load, and Vim
" re-sources the colorscheme when 'background' changes, so the bar turns
" with the page.
function! airline#themes#swan_budapest_winter#refresh() abort
  if &background ==# 'light'
    " normal: the mode block wears ink
    let s:normal_a = ['#eeebf2', '#211b28', 255, 234]
    let s:normal_b = ['#211b28', '#d8d3de', 234, 253]
    let s:normal_c = ['#211b28', '#e5e1ea', 234, 254]
    let g:airline#themes#swan_budapest_winter#palette.normal = airline#themes#generate_color_map(s:normal_a, s:normal_b, s:normal_c)
    let g:airline#themes#swan_budapest_winter#palette.normal_modified = { 'airline_c': ['#873e61', '#e5e1ea', 132, 254] }

    " insert: the mode block wears quote
    let s:insert_a = ['#eeebf2', '#754e2b', 255, 94]
    let s:insert_b = ['#211b28', '#d8d3de', 234, 253]
    let s:insert_c = ['#211b28', '#e5e1ea', 234, 254]
    let g:airline#themes#swan_budapest_winter#palette.insert = airline#themes#generate_color_map(s:insert_a, s:insert_b, s:insert_c)
    let g:airline#themes#swan_budapest_winter#palette.insert_modified = { 'airline_c': ['#873e61', '#e5e1ea', 132, 254] }

    " replace: the mode block wears alert
    let s:replace_a = ['#eeebf2', '#ad122c', 255, 88]
    let s:replace_b = ['#211b28', '#d8d3de', 234, 253]
    let s:replace_c = ['#211b28', '#e5e1ea', 234, 254]
    let g:airline#themes#swan_budapest_winter#palette.replace = airline#themes#generate_color_map(s:replace_a, s:replace_b, s:replace_c)
    let g:airline#themes#swan_budapest_winter#palette.replace_modified = { 'airline_c': ['#873e61', '#e5e1ea', 132, 254] }

    " visual: the mode block wears opt
    let s:visual_a = ['#eeebf2', '#4d5579', 255, 60]
    let s:visual_b = ['#211b28', '#d8d3de', 234, 253]
    let s:visual_c = ['#211b28', '#e5e1ea', 234, 254]
    let g:airline#themes#swan_budapest_winter#palette.visual = airline#themes#generate_color_map(s:visual_a, s:visual_b, s:visual_c)
    let g:airline#themes#swan_budapest_winter#palette.visual_modified = { 'airline_c': ['#873e61', '#e5e1ea', 132, 254] }

    " An inactive split recedes by going quiet, never by becoming unreadable.
    let g:airline#themes#swan_budapest_winter#palette.inactive = airline#themes#generate_color_map(['#66616c', '#e5e1ea', 241, 254], ['#66616c', '#e5e1ea', 241, 254], ['#66616c', '#e5e1ea', 241, 254])
    let g:airline#themes#swan_budapest_winter#palette.inactive_modified = { 'airline_c': ['#66616c', '#e5e1ea', 241, 254] }

    " The tab strip: the current tab is a paper step, the others recede one
    " ink weight.  Same reasoning as the completion menu -- a filled accent
    " block for the selected row is the heaviest thing on the page.
    let g:airline#themes#swan_budapest_winter#palette.tabline = {
          \ 'airline_tab':     ['#433e4b', '#e5e1ea', 238, 254],
          \ 'airline_tabsel':  ['#211b28', '#d0cad7', 234, 252],
          \ 'airline_tabtype': ['#eeebf2', '#754e2b', 255, 94],
          \ 'airline_tabfill': ['#433e4b', '#e5e1ea', 238, 254],
          \ 'airline_tabmod':  ['#eeebf2', '#873e61', 255, 132],
          \ 'airline_tabhid':  ['#66616c', '#e5e1ea', 241, 254],
          \ }

    " Warning and error accents, used by the whitespace and diagnostics parts.
    let g:airline#themes#swan_budapest_winter#palette.accents = { 'red': ['#ad122c', '#e5e1ea', 88, 254] }
  else
    " normal: the mode block wears ink
    let s:normal_a = ['#1a131f', '#f6eae9', 234, 255]
    let s:normal_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:normal_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest_winter#palette.normal = airline#themes#generate_color_map(s:normal_a, s:normal_b, s:normal_c)
    let g:airline#themes#swan_budapest_winter#palette.normal_modified = { 'airline_c': ['#ffa7ce', '#241c2b', 218, 235] }

    " insert: the mode block wears quote
    let s:insert_a = ['#1a131f', '#fac89f', 234, 223]
    let s:insert_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:insert_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest_winter#palette.insert = airline#themes#generate_color_map(s:insert_a, s:insert_b, s:insert_c)
    let g:airline#themes#swan_budapest_winter#palette.insert_modified = { 'airline_c': ['#ffa7ce', '#241c2b', 218, 235] }

    " replace: the mode block wears alert
    let s:replace_a = ['#1a131f', '#fd6467', 234, 203]
    let s:replace_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:replace_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest_winter#palette.replace = airline#themes#generate_color_map(s:replace_a, s:replace_b, s:replace_c)
    let g:airline#themes#swan_budapest_winter#palette.replace_modified = { 'airline_c': ['#ffa7ce', '#241c2b', 218, 235] }

    " visual: the mode block wears opt
    let s:visual_a = ['#1a131f', '#c6cdf7', 234, 189]
    let s:visual_b = ['#f6eae9', '#2d2336', 255, 236]
    let s:visual_c = ['#f6eae9', '#241c2b', 255, 235]
    let g:airline#themes#swan_budapest_winter#palette.visual = airline#themes#generate_color_map(s:visual_a, s:visual_b, s:visual_c)
    let g:airline#themes#swan_budapest_winter#palette.visual_modified = { 'airline_c': ['#ffa7ce', '#241c2b', 218, 235] }

    " An inactive split recedes by going quiet, never by becoming unreadable.
    let g:airline#themes#swan_budapest_winter#palette.inactive = airline#themes#generate_color_map(['#9e92a2', '#241c2b', 246, 235], ['#9e92a2', '#241c2b', 246, 235], ['#9e92a2', '#241c2b', 246, 235])
    let g:airline#themes#swan_budapest_winter#palette.inactive_modified = { 'airline_c': ['#9e92a2', '#241c2b', 246, 235] }

    " The tab strip: the current tab is a paper step, the others recede one
    " ink weight.  Same reasoning as the completion menu -- a filled accent
    " block for the selected row is the heaviest thing on the page.
    let g:airline#themes#swan_budapest_winter#palette.tabline = {
          \ 'airline_tab':     ['#cfc3cd', '#241c2b', 251, 235],
          \ 'airline_tabsel':  ['#f6eae9', '#34293d', 255, 237],
          \ 'airline_tabtype': ['#1a131f', '#fac89f', 234, 223],
          \ 'airline_tabfill': ['#cfc3cd', '#241c2b', 251, 235],
          \ 'airline_tabmod':  ['#1a131f', '#ffa7ce', 234, 218],
          \ 'airline_tabhid':  ['#9e92a2', '#241c2b', 246, 235],
          \ }

    " Warning and error accents, used by the whitespace and diagnostics parts.
    let g:airline#themes#swan_budapest_winter#palette.accents = { 'red': ['#fd6467', '#241c2b', 203, 235] }
  endif
endfunction

call airline#themes#swan_budapest_winter#refresh()

